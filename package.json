{
  "name": "sourcefold-wiki",
  "version": "0.1.0",
  "description": "Public Sourcefold wiki and reference fold CLI.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sourcefold": "./dist/cli/index.js"
  },
  "main": "./dist/lib/index.js",
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "npm run build:cli && npm run build:docs",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:docs": "vitepress build docs",
    "preview": "vitepress preview docs",
    "fold": "node dist/cli/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "keywords": [
    "sourcefold",
    "markdown",
    "llm",
    "vitepress",
    "wiki"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SM260845/sourcefold-wiki.git"
  },
  "homepage": "https://github.com/SM260845/sourcefold-wiki",
  "bugs": {
    "url": "https://github.com/SM260845/sourcefold-wiki/issues"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vitepress": "1.6.4",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "ignore": "7.0.9"
  }
}
